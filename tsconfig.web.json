{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.vue",
    "src/shared/**/*.ts",
    "src/shared/**/*.d.ts",
    "src/preload/*.d.ts"

  ],
  "compilerOptions": {
    "composite": true,
 
    "paths": {
      "@renderer/*": [
     

        "./src/renderer/src/*"
      ],
         "@shared/*": [
     

        "./src/shared/*"
      ]
    }
  }
}
